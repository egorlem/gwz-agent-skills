#!/usr/bin/env zsh
# Gate: проверить стенд zpty на встроенной фикстуре.
#
# Использование:
#   verify/gate.zsh
#
# Зачем нужен: сломанный стенд и сломанный комплишен снаружи выглядят одинаково
# (нет совпадений, звонок, вывод — только эхо). Скрипт прогоняет сам стенд на
# tests/fixtures/_demo, прежде чем ему доверят реальный комплишен. Он
# самодостаточен и не использует внешних инструментов, поэтому работает даже
# когда целевая команда не установлена.
#
# Коды возврата:
#   0   стенд работает: оба кейса фикстуры проходят
#   1   стенд отработал, но кейсы фикстуры провалились
#   77  нет PTY: zpty не может запустить shell в этом окружении
#
# Печатает одну строку: pass, fail: <reason> или no-pty.

# ---------------------------------------------------------------------------
# Настройка
# ---------------------------------------------------------------------------

emulate -L zsh
# Локальные предсказуемые опции; не наследуем nullglob/shwordsplit вызывающего.

typeset -g DIR=${0:A:h}
# Абсолютный каталог скрипта, чтобы соседние скрипты находились независимо от
# текущего каталога вызывающего.

typeset -g FIXTURES=$DIR/../../tests/fixtures
# Встроенная фикстура — эталонный комплишен (_demo).

typeset -g LOG=
typeset -g GATE_TMP=
# Глобальные намеренно: EXIT-trap срабатывает после возврата из __main, когда
# локальные переменные уже мертвы. Trap должен видеть путь, чтобы удалить его.

# ---------------------------------------------------------------------------
# Вспомогательные функции
# ---------------------------------------------------------------------------

__no_pty() {
  print -r -- 'no-pty'
  return 77
  # 77 отделён от 1, чтобы preflight/вызывающий мог сказать "окружение", а не
  # "комплишен неверен".
}

__fail() {
  local reason=$1
  print -r -- "fail: $reason"
  if [[ -n $LOG && -f $LOG ]]; then
    grep 'missing:' "$LOG" 2>/dev/null | head -n 3 | sed 's/^/  /'
    # Показываем, каких ожидаемых строк стенд не увидел. head -n 3 держит вывод
    # коротким; preflight схлопывает его в одну строку key=value.
  fi
  return 1
}

# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

__main() {
  # --- Возможность PTY -----------------------------------------------------

  if ! zmodload zsh/zpty 2>/dev/null; then
    __no_pty
    return
    # Сам модуль отсутствует: комплишен проверить нельзя.
  fi

  local session="gwzgate$$"
  zpty -d "$session" 2>/dev/null
  # Уникальное имя (PID) защищает от коллизий параллельных запусков; -d
  # убирает stale-сессию после прошлого краша.

  if ! zpty "$session" /bin/sh -c true 2>/dev/null; then
    __no_pty
    return
    # Самый дешёвый возможный запуск. Если он не удался, стенд не заработает,
    # и отладка фикстуры не поможет.
  fi
  zpty -d "$session" 2>/dev/null
  # Сразу освобождаем проверочную сессию; реальную работу делает
  # verify/harness.zsh ниже.

  # --- Временный лог -------------------------------------------------------

  GATE_TMP=$(mktemp -d "${TMPDIR:-/tmp}/gwz-gate.XXXXXX") || {
    print -r -- 'fail: mktemp'
    return 1
    # Нет временного места — не можем захватить вывод стенда. Сообщаем об
    # ошибке стенда, а не о ложном успехе.
  }
  LOG=$GATE_TMP/log
  trap 'rm -rf -- "$GATE_TMP"' EXIT
  # Захватываем вывод стенда для разбора при провале и удаляем временный
  # каталог на любом пути выхода (успех, провал, no-pty).

  # --- Кейс 1: список команд ----------------------------------------------

  if ! zsh "$DIR/harness.zsh" "$FIXTURES" demo \
      --expect install --expect status $'demo \t' >"$LOG" 2>&1; then
    # Кейс проверяет _describe: три команды, завершение пустого слова. Это
    # самая дешёвая проверка, что compinit загрузился, _demo зарегистрирован,
    # а state machine дошла до списка команд.

    if grep -q "can't open pseudo terminal" "$LOG" 2>/dev/null; then
      __no_pty
      return
      # zpty может существовать, но всё равно не выделить PTY (sandbox, лимиты).
      # Это результат окружения, а не провал фикстуры.
    fi
    __fail 'demo commands'
    return
  fi

  # --- Кейс 2: опции подкоманды -------------------------------------------

  if ! zsh "$DIR/harness.zsh" "$FIXTURES" demo \
      --expect --force $'demo install --\t' >"$LOG" 2>&1; then
    # Кейс проверяет _arguments в контексте подкоманды: ловит класс ошибок
    # "глобальная опция перехватила опцию подкоманды" и доказывает, что
    # диспатч дошёл до _demo_install. Стенд, который умеет только список
    # команд, может пройти кейс 1 и провалить этот.

    if grep -q "can't open pseudo terminal" "$LOG" 2>/dev/null; then
      __no_pty
      return
    fi
    __fail 'demo install options'
    return
  fi

  # --- Результат -----------------------------------------------------------

  print -r -- 'pass'
  return 0
  # И список команд, и опции подкоманды работают на фикстуре — стенду можно
  # доверять целевой комплишен.
}

__main "$@"
